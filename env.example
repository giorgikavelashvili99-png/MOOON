DISCORD_BOT_TOKEN=your_second_bot_token_here

# Shared secret this bot checks on every incoming request. Must match the
# value the Cloudflare Worker proxy (discord-tiktok-notify-worker.js) sends
# as the X-Api-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=generate_a_long_random_value_here

# Optional -- most platforms (Railway/Render/Heroku) set this for you
# automatically. Only set it yourself for local testing.
PORT=8080
